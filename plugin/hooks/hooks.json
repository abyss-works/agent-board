{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agb",
            "args": ["hook", "session-start", "--tool", "claude"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "agb",
            "args": ["hook", "pre-commit", "--tool", "claude"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
